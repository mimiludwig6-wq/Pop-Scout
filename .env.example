# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# --- Notion ---------------------------------------------------------------
# https://www.notion.so/my-integrations -> New integration -> copy the secret,
# then share both databases with that integration.
NOTION_TOKEN=
NOTION_ARTISTS_DB=
NOTION_SOURCES_DB=
NOTION_VISITORS_DB=

# --- Revalidation ---------------------------------------------------------
# Any long random string. Guards /api/revalidate so strangers can't trigger
# cache busting. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=
