# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# --- Notion ---------------------------------------------------------------
# https://www.notion.so/my-integrations -> New integration -> copy the secret,
# then share both databases with that integration.
NOTION_TOKEN=
NOTION_ARTISTS_DB=
NOTION_SOURCES_DB=

# --- Spotify --------------------------------------------------------------
# https://developer.spotify.com/dashboard -> Create app.
# Client Credentials flow only — no user login, no redirect URI needed.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Cron / revalidation --------------------------------------------------
# Any long random string. Guards the refresh + revalidate endpoints so they
# can't be triggered by strangers. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=
